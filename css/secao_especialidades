.secao_especialidades {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 40px 20px;
}
.secao_especialidades_titulo_texto {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 4em 0 0 0;
}

.secao_especialidades_titulo_img{
    max-width: 100px;
    max-height: 100px;
    object-fit: contain;
    margin: 1em auto;

}

.swiper{
    width:100%;
    max-width: 400px;
    margin:0 auto;
}

.swiper-slide{
    width: 300px;
    height: auto;
    display:flex;
    flex-direction:column;
    align-items:center;
}

.swiper-slide img{
    width: 100%;
    height: 100%;
    object-fit: contain;   
    margin: 0 auto;
    border-radius:20px;
    box-shadow:0 10px 25px rgba(0,0,0,.12);
}
 